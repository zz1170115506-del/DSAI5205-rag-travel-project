# 留空即可完整运行本地演示。复制为 .env 后只在自己电脑填写，勿上传 GitHub。
MODEL_API_KEY=
# ModelScope API-Inference: use your own ModelScope access token, not an NVIDIA key.
# Account eligibility, trial quota and availability are determined by ModelScope.
MODEL_BASE_URL=https://api-inference.modelscope.cn/v1
MODEL_NAME=deepseek-ai/DeepSeek-V4.1-Flash-1017
AMAP_API_KEY=
# Enable after saving your own AMap Web Service key; local misses may query Hong Kong POIs.
# With model mode enabled, retrieved POI fields are also sent to the configured model service.
AMAP_ENABLED=false

# Optional local embeddings: install requirements-embedding.txt and build the index first.
# bm25 = keyword retrieval; hybrid = BM25 + local BGE vectors, with BM25 fallback.
RETRIEVAL_MODE=hybrid
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# Cosine threshold, not a probability or measured accuracy.
EMBEDDING_MIN_SCORE=0.5

# Optional password-protected cloud demo; keep disabled for normal local use.
PUBLIC_DEMO=false
# Render supplies RENDER_EXTERNAL_URL automatically; another host needs its fixed HTTPS URL here.
PUBLIC_ORIGIN=
DEMO_USERNAME=team
# Use a separate random password of at least 16 characters; never use an API key.
DEMO_PASSWORD=
