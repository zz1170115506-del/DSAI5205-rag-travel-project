# Shared root .env; never commit credentials. Select the app-specific section.

# Local application: python3 start.py (port 8765)
# 留空即可完整运行本地演示。复制为 .env 后只在自己电脑填写，勿上传 GitHub。
MODEL_API_KEY=
# ModelScope API-Inference: use your own ModelScope access token, not an NVIDIA key.
# Account eligibility, trial quota and availability are determined by ModelScope.
MODEL_BASE_URL=https://api-inference.modelscope.cn/v1
MODEL_NAME=deepseek-ai/DeepSeek-V4.1-Flash-1017
AMAP_API_KEY=
# Enable after saving your own AMap Web Service key; local misses may query Hong Kong POIs.
# With model mode enabled, retrieved POI fields are also sent to the configured model service.
AMAP_ENABLED=false

# Optional local embeddings: install requirements-embedding.txt and build the index first.
# bm25 = keyword retrieval; hybrid = BM25 + local BGE vectors, with BM25 fallback.
RETRIEVAL_MODE=hybrid
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# Cosine threshold, not a probability or measured accuracy.
EMBEDDING_MIN_SCORE=0.5

# Optional password-protected cloud demo; keep disabled for normal local use.
PUBLIC_DEMO=false
# Explicit opt-in for anonymous public access; shared archives are disabled.
PUBLIC_DEMO_ANONYMOUS=false
# Render supplies RENDER_EXTERNAL_URL automatically; another host needs its fixed HTTPS URL here.
PUBLIC_ORIGIN=
DEMO_USERNAME=team
# Use a separate random password of at least 16 characters; never use an API key.
DEMO_PASSWORD=

# Docker fullstack: sh scripts/start-demo.sh (port 8080)
# Copy to .env. Root .env is the only local configuration file; never commit it.
APP_ENV=development
WEB_PORT=8080
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
COOKIE_SECURE=false

# Docker always connects via mysql service; local Python may use SQLite for a smoke run.
DATABASE_URL=sqlite:///./travel.db
MYSQL_HOST=mysql
MYSQL_DATABASE=travel
MYSQL_USER=travel
MYSQL_PASSWORD=replace-with-random-app-password
MYSQL_ROOT_PASSWORD=replace-with-another-random-root-password

# mock = offline flow checks (lexical hash embeddings + evidence concatenation).
# remote = real OpenAI-compatible /chat/completions and /embeddings endpoints.
MODEL_MODE=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# mock uses 256; remote MUST use your selected model's actual dimension.
EMBEDDING_DIM=256
# DATA_ROOT omitted: local defaults to project data/, Docker explicitly sets /data.
ENABLE_GRAPH=true
ENABLE_MEMORY=true
MAX_TOOL_CALLS=6
RUN_TIMEOUT_SECONDS=60
MODEL_TIMEOUT_SECONDS=30
MAX_ACTIVE_RUNS=8
MOCK_TOKEN_DELAY=0.015
